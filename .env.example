# Domínio desta landing, com esquema e sem barra no fim.
# Ex.: https://piazzanicomedes.com.br
# Sem ele o build usa o endereço que a Vercel gera para o projeto, e o sitemap,
# o robots e a imagem de compartilhamento saem apontando para lá.
NEXT_PUBLIC_SITE_URL=

# Repositório onde o painel do Keystatic grava em produção, no formato
# usuario/repositorio. Sem ela o painel roda em modo local, que grava direto no
# disco sem pedir login: por isso /keystatic e a API dele não existem em
# produção enquanto esta variável estiver vazia.
KEYSTATIC_GITHUB_REPO=

# Site institucional, para o único link de saída da landing, no rodapé.
# Padrão: https://nexamalls.com.br
NEXT_PUBLIC_SITE_NEXA=

# Token permanente da API do Zaper, em Ajustes > Integrações > Integração via
# API (ver src/app/api/lead/route.ts e src/lib/zaper.ts). Começa com "pn_".
# Sem ele, o lead segue normalmente pelo WhatsApp e fica só registrado no log
# do servidor — nada quebra, só falta o Zaper recebê-lo.
#
# O mesmo token serve todas as LPs e o site: quem distingue a origem é o campo
# `lpOrigem` do payload (o nome desta pasta), que também escolhe a etiqueta do
# contato — por isso duas LPs com a mesma copy continuam separáveis no CRM.
#
# Substituiu ZAPER_WEBHOOK_URL, do tempo em que havia um webhook do Make no
# meio do caminho. O Make foi desligado em 09/2026.
ZAPER_API_TOKEN=

# Opcionais, só para apontar a outro painel sem precisar de deploy. Vazias, o
# código usa o painel "Leads de anúncios" e a etapa "Novo lead".
ZAPER_PANEL_ID=
ZAPER_STEP_ID=
